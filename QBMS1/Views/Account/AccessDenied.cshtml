@{
    ViewData["Title"] = "Access Denied";
}

<div style="min-height:75vh;display:flex;align-items:center;
            justify-content:center;padding:25px;">

    <div style="max-width:600px;width:100%;padding:40px 25px;
                text-align:center;border-radius:20px;
                border:1px solid rgba(100,140,180,.3);
                background:rgba(255,255,255,.8);
                box-shadow:0 12px 40px rgba(20,50,80,.12);">

        <h1 style="font-size:70px;color:#1769aa;font-weight:800;">
            403
        </h1>

        <h2>Access Denied</h2>

        <p style="margin:20px 0;color:#52677a;">
            You are not authorized to access this resource.
            Please contact your administrator if you believe
            this is an error.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary">
            Return to Login
        </a>
    </div>
</div>


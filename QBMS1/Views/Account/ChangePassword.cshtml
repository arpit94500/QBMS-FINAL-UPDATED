@model QBMS.Application.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    var isFirstLogin = ViewBag.IsFirstLogin == true;
}

<div class="login-container">

    <div class="login-card">

        <div class="login-header">

            <h1>Change Password</h1>

            @if (isFirstLogin)
            {
                <p>
                    You are using a default or reset password.
                    Please set a new password to continue.
                </p>
            }
            else
            {
                <p>
                    Choose a new password for your account.
                </p>
            }

        </div>


        <form asp-action="ChangePassword"
              asp-controller="Account"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="error-message">
            </div>


            <div class="form-group">

                <label asp-for="CurrentPassword">
                    Current Password
                </label>

                <input asp-for="CurrentPassword"
                       type="password"
                       class="qbms-input"
                       autocomplete="current-password"
                       required />

            </div>


            <div class="form-group">

                <label asp-for="NewPassword">
                    New Password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       class="qbms-input"
                       autocomplete="new-password"
                       required />

                <div class="form-hint">
                    At least 8 characters with an uppercase letter,
                    a lowercase letter, a digit and a special character.
                    It cannot be the default password.
                </div>

            </div>


            <div class="form-group">

                <label asp-for="ConfirmPassword">
                    Confirm New Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="qbms-input"
                       autocomplete="new-password"
                       required />

            </div>


            <button type="submit"
                    class="sync-button login-button">

                Change Password

            </button>

        </form>

    </div>

</div>

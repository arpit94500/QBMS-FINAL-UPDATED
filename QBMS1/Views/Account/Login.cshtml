@model QBMS.Application.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-container">

    <div class="login-card">

        <div class="login-header">

            <h1>e-Prashnalaya</h1>

            <p>
                Question Bank Management System
            </p>

        </div>


        <form asp-action="Login"
              asp-controller="Account"
              method="post"
              id="loginForm"
              data-public-key="@ViewBag.LoginPublicKey"
              data-challenge="@ViewBag.LoginChallenge">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="error-message">
            </div>


            <div class="form-group">

                <label>
                    Personnel No
                </label>

                <input asp-for="PersonnelNo"
                       class="qbms-input"
                       autocomplete="username"
                       required />

            </div>


            <div class="form-group">

                <label>
                    Password
                </label>

                @* No name attribute: the plain password is never submitted.
                   login-crypto.js encrypts it into the hidden EncryptedPassword field. *@
                <input type="password"
                       id="loginPassword"
                       class="qbms-input"
                       autocomplete="current-password"
                       required />

                <input asp-for="EncryptedPassword" type="hidden" />

                <span asp-validation-for="EncryptedPassword" class="error-message"></span>

            </div>


            <button type="submit"
                    class="sync-button login-button">

                Login

            </button>

        </form>

    </div>

</div>

@section Scripts {
    <script src="~/js/login-crypto.js" asp-append-version="true"></script>
}

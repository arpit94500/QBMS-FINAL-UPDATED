@model QBMS.Application.Models.TosAssignmentViewModel

@{
    ViewData["Title"] = "TOS Assignment";
}

<div class="dashboard-container">

    <div class="dashboard-header">

        <div>
            <h1>TOS Assignment</h1>

            <p>
                Select the required hierarchy level
                for assignment.
            </p>
        </div>

        <div>
            <a asp-controller="Admin"
               asp-action="TosAssignmentManagement"
               class="back-button">
                Assignment Management
            </a>
            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="back-button">
                Dashboard
            </a>
        </div>

    </div>
    <div class="glass-card">
        <h3 class="panel-heading">1. Assignment type</h3>
    <div class="form-row">

        <div class="form-group">

            <label>
                Assignment Level
            </label>

            <select id="ddlAssignmentLevel"
                    class="qbms-select">

                <option value="">
                    Select Level
                </option>

                <option value="PAPER">
                    Paper
                </option>

                <option value="SECTION">
                    Section
                </option>

                <option value="SUBSECTION">
                    SubSection
                </option>

                <option value="TOPIC">
                    Topic
                </option>

            </select>

        </div>


        <div class="form-group">

            <label>
                Multiplication Factor
            </label>

            <input type="number"
                   id="txtFactor"
                   class="qbms-input"
                   value="1"
                   min="1"
                   step="1" />

        </div>

    </div>
    </div>

    <div class="assignment-panel">
        <h3 class="panel-heading">2. Scope (hierarchy)</h3>

        <p class="form-hint" id="scopeHint">Choose the assignment level first; only the hierarchy fields it needs are shown.</p>

        <div class="form-row">

            <div class="form-group scope-field" data-min-rank="1" hidden>
                <label>Exam</label>

                <select id="ddlExam"
                        class="qbms-select">

                    <option value="">
                        Select Exam
                    </option>

                    @foreach (var item in Model.Exams)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>
            </div>


            <div class="form-group scope-field" data-min-rank="1" hidden>
                <label>Paper</label>

                <select id="ddlPaper"
                        class="qbms-select"
                        disabled>

                    <option value="">
                        Select Paper
                    </option>

                </select>
            </div>

        </div>


        <div class="form-row">

            <div class="form-group scope-field" data-min-rank="2" hidden>
                <label>Section</label>

                <select id="ddlSection"
                        class="qbms-select"
                        disabled>

                    <option value="">
                        Select Section
                    </option>

                </select>
            </div>


            <div class="form-group scope-field" data-min-rank="3" hidden>
                <label>SubSection</label>

                <select id="ddlSubsection"
                        class="qbms-select"
                        disabled>

                    <option value="">
                        Select SubSection
                    </option>

                </select>
            </div>

        </div>


        <div class="form-row">

            <div class="form-group scope-field" data-min-rank="4" hidden>

                <label>Topic</label>

                <select id="ddlTopic"
                        class="qbms-select"
                        disabled>

                    <option value="">
                        Select Topic
                    </option>

                </select>

            </div>

        </div>


        <hr />
        <h3 class="panel-heading">3. Responsible users</h3>





        <div class="form-row">

            <div class="form-group">

                <label>
                    Setter
                </label>

                <select id="ddlSetter"
                        class="qbms-select">

                    <option value="">
                        Select Setter
                    </option>
                    @foreach (var item in Model.Setters)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }

                </select>

            </div>


            <div class="form-group">

                <label>
                    Vetter
                </label>

                <select id="ddlVetter"
                        class="qbms-select">

                    <option value="">
                        Select Vetter
                    </option>
                    @foreach (var item in Model.Vetters)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }

                </select>

            </div>

        </div>


        <div class="assignment-summary">

            <h3>Assignment Scope</h3>

            <div id="assignmentDescription">
                Select the hierarchy and assignment
                level.
            </div>

        </div>


        <button type="button"
                id="btnAssign"
                class="sync-button qbms-btn">

            Assign

        </button>
        <div id="assignmentMessage" class="assignment-message"></div>

    </div>

</div>

@section Scripts {

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        window.qbmsUrls = {
            getPapers: '@Url.Action("GetPapers","Admin")',
            getSections: '@Url.Action("GetSections","Admin")',
            getSubsections: '@Url.Action("GetSubsections","Admin")',
            getTopics: '@Url.Action("GetTopics","Admin")',
            createAssignment: '@Url.Action("CreateAssignment","Admin")'
        };
    </script> 
    <script src="~/js/tos-assignment.js"></script>
}

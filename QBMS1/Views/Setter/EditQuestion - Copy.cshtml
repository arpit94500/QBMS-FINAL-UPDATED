@model QBMS.Application.Models.EditQuestionViewModel

@{
    ViewData["Title"] = "Correct Question";
}
<link rel="stylesheet"
      href="~/css/question-editor.css" />

<div class="container mt-4 mb-5">

    <div class="card shadow-sm">

        <div class="card-header qbms-question-header">
            <h4 class="mb-0">
                Edit Question
            </h4>
        </div>

        <div>
            <a asp-controller="Setter"
               asp-action="Dashboard"
               class="back-button">
                Back
            </a>
        </div>

    </div>


    @if (!string.IsNullOrWhiteSpace(
      Model.LatestRemarks))
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">

            <strong>
                Reviewer Remarks:
            </strong>

            <br />

            @Html.Raw(Model.LatestRemarks)
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>

        </div>
    }
    <form asp-controller="Setter" asp-action="EditQuestion" method="post" id="questionForm" autocomplete="off">

    </form>


    <div class="assignment-panel">

        <div class="form-group">

            <label>
                Exam
            </label>

            <input class="qbms-input"
                   value="@Model.ExamName"
                   readonly />

        </div>


        <div class="form-row">

            <div class="form-group">

                <label>
                    Paper
                </label>

                <input class="qbms-input"
                       value="@Model.PaperName"
                       readonly />

            </div>

            <div class="form-group">

                <label>
                    Section
                </label>

                <input class="qbms-input"
                       value="@Model.SectionName"
                       readonly />

            </div>

        </div>


        <div class="form-row">

            <div class="form-group">

                <label>
                    SubSection
                </label>

                <input class="qbms-input"
                       value="@Model.SubsectionName"
                       readonly />

            </div>

            <div class="form-group">

                <label>
                    Topic
                </label>

                <input class="qbms-input"
                       value="@Model.TopicName"
                       readonly />

            </div>

        </div>


        <form asp-controller="Setter"
              asp-action="EditQuestion"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="QuestionId" />

            <div class="form-group">

                <label>
                    Question Type
                </label>

                <select asp-for="QuestionType"
                        class="qbms-select">

                    <option value="SUBJECTIVE">
                        SUBJECTIVE
                    </option>

                </select>

            </div>


            <div class="form-group">

                <label>
                    Difficulty
                </label>

                <select asp-for="DifficultyLevel"
                        class="qbms-select">

                    @foreach (
                     var difficulty
                     in Model.Difficulties)
                    {
                        <option value="@difficulty">
                            @difficulty
                        </option>
                    }

                </select>

            </div>


           <div class="form-group">

            <label>
                Corrected Question
            </label>

            <textarea asp-for="QuestionText"
                      class="qbms-textarea"
                      rows="10"
                      required></textarea>

        </div>

            <div class="qbms-section-title mt-3">
                Question
            </div>

            <div class="form-group">

                <label class="form-label">
                    Question Text
                    <span class="text-danger">*</span>
                </label>

                <div class="question-editor-container">

                    <!-- TOOLBAR -->

                    <div class="question-toolbar">

                        <button type="button"
                                class="question-tool-btn"
                                data-command="bold"
                                title="Bold">
                            <b>B</b>
                        </button>

                        <button type="button"
                                class="question-tool-btn"
                                data-command="italic"
                                title="Italic">
                            <i>I</i>
                        </button>

                        <button type="button"
                                class="question-tool-btn"
                                data-command="underline"
                                title="Underline">
                            <u>U</u>
                        </button>

                        <button type="button"
                                class="question-tool-btn"
                                id="questionImageBtn"
                                title="Insert Image">

                            🖼 Image

                        </button>

                        <input type="file"
                               id="questionImageInput"
                               accept="image/*"
                               style="display:none;" />

                        <button type="button"
                                class="question-tool-btn"
                                id="questionMathBtn"
                                title="Insert Math">

                            ∑ Math

                        </button>

                    </div>

                    <!-- EDITOR -->

                    <div id="questionEditor"
                         class="question-editor"
                         contenteditable="true"
                         spellcheck="true"
                         data-placeholder="Enter your question here..."
                        asp-for="QuestionText"
                        rows="10"
                        required>
                    </div>

                </div>

                <!-- VERY IMPORTANT:
        This is what MVC receives. -->

                


                <button type="submit"
                        class="sync-button">

                    Save Correction

                </button>

        </form>

    </div>

</div>

@* Read-only math rendering: MathJax (configured before it loads) + qbms-math.js. Add to any page that shows saved questions. *@
<script>
    window.MathJax = {
        tex: {
            inlineMath: [['\\(', '\\)']],
            displayMath: [['\\[', '\\]']],
            processEscapes: true
        },
        options: {
            skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
        },
        startup: { typeset: false }
    };
</script>
<script src="~/lib/MathJax-3.2.2/es5/tex-chtml.js" async></script>
<script src="~/js/qbms-math.js" asp-append-version="true"></script>
